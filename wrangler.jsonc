{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "seeder",
  "compatibility_date": "2026-04-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "PM_DB",
      "database_name": "seeder",
      "database_id": "73f0b101-0de5-41ea-bbcb-e265da620c9a",
      "preview_database_id": "73f0b101-0de5-41ea-bbcb-e265da620c9a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "seeder-uploads",
      "preview_bucket_name": "seeder-uploads"
    }
  ]
}
